# Anthropic API key for the agent runtime LLM calls.
ANTHROPIC_API_KEY=sk-ant-...

# Agent model. Default is claude-sonnet-4-6 (cost-effective, Standard tier).
# Set claude-opus-4-7 for the Pro tier / deepest exploration.
MIMIX_MODEL=claude-sonnet-4-6

# Solana RPC URL — devnet for the hackathon demo.
SOLANA_RPC_URL=https://api.devnet.solana.com

# Treasury wallet — base58-encoded 64-byte secret key (the same format
# `solana-keygen new --no-bip39-passphrase --outfile -` produces, as
# JSON array). For the demo we read a JSON keypair file path instead.
TREASURY_KEYPAIR_PATH=./treasury-keypair.json
TREASURY_PUBKEY=

# Mimix USDG-mock SPL token mint, populated by `pnpm deploy:usdg`.
USDG_MINT=

# Passphrase passed to the forked Zerion CLI by the agent runtime.
# Persona wallets are ephemeral; the passphrase only protects the
# in-memory keystore for the duration of a single run.
MIMIX_PASSPHRASE=mimix-dev

# Per-persona turn cap (default 10). Personas that exceed it land in
# "capped" status with an "Upgrade plan" CTA.
MIMIX_TURN_BUDGET=10

# Set to 1 to force scripted (fake-LLM) mode even when ANTHROPIC_API_KEY
# is present. Leave blank for normal behavior.
MIMIX_FAKE_LLM=

# Backstop timeout (ms) for a single persona's agent process; the
# orchestrator kills a hung agent past this. Default 900000 (15 min).
MIMIX_AGENT_TIMEOUT_MS=900000

# Enables the "Skip payment (debug)" button on /pay during live demos
# so judges do not need to fund a Phantom wallet.
NEXT_PUBLIC_DEBUG_MODE=true

# Email notifications (SMTP via nodemailer). All optional — if unset,
# Mimix logs a warning and skips sending. Operator gets a "run started"
# email; the requester gets a "report ready" email.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
MIMIX_OPERATOR_EMAIL=
# Public base URL used to build the report link in emails.
MIMIX_PUBLIC_URL=http://localhost:3000

# Payment settlement (fallback / direct Solana Pay path). When set,
# /api/pay/verify checks for a USDC transfer to MIMIX_PAYOUT_ADDRESS on
# PAYMENT_RPC_URL; otherwise it falls back to the devnet USDG demo flow.
USDC_MINT=
MIMIX_PAYOUT_ADDRESS=
PAYMENT_RPC_URL=

# NowPayments — primary hosted checkout (USDC across Solana + Ethereum +
# Base + Arbitrum + Optimism + Polygon). Configure receive addresses in
# the NowPayments dashboard (Solana wallet for USDC-SOL, EVM wallet for
# all EVM USDC variants). Get API key + IPN secret from the dashboard.
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=

# Per-persona price in USD (default 9). Set the NEXT_PUBLIC_* one too so
# the /pay page shows the same number — baked into the client bundle at
# build time.
MIMIX_PRICE_PER_PERSONA_USD=9
NEXT_PUBLIC_PRICE_PER_PERSONA_USD=9

# Operator EVM payout address — same 0x... works on Ethereum, Base,
# Arbitrum, Optimism, Polygon. Configured in NowPayments dashboard,
# not read by code (documented here for reference).
# MIMIX_PAYOUT_ADDRESS_EVM=0x3402c2Cdc332b4806C95473654e2eAfE9ec508b0
