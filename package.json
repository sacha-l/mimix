{
  "name": "mimix",
  "version": "0.1.0",
  "private": true,
  "description": "Marketplace of autonomous Solana agent-personas that test dApps via a forked Zerion CLI.",
  "license": "MIT",
  "packageManager": "pnpm@10.8.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @mimix/web dev",
